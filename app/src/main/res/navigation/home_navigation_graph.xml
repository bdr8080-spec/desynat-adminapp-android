<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/home"
    android:id="@+id/home_navigation_graph">

    <fragment
        android:id="@+id/home"
        android:name="com.desynatadmin.ui.home.fragment.HomeFragment"
        android:label="Home Fragment"
        tools:layout="@layout/fragment_home"/>

    <fragment
        android:id="@+id/planList"
        android:name="com.desynatadmin.ui.home.subscriptionPlan.PlanListFragment"
        android:label="Subscription Plan Fragment"
        tools:layout="@layout/fragment_plan_list">

        <action
            android:id="@+id/action_planList_to_addPlanFragment"
            app:destination="@id/addPlan" />

        <action
            android:id="@+id/action_planList_to_planDetailFragment"
            app:destination="@id/planDetail" />

    </fragment>

    <fragment
        android:id="@+id/planDetail"
        android:name="com.desynatadmin.ui.home.subscriptionPlan.PlanDetailFragment"
        android:label="Plan Detail Fragment"
        tools:layout="@layout/fragment_plan_detail">

    <action
        android:id="@+id/action_planDetail_to_addPlanFragment"
        app:destination="@id/addPlan" />

    </fragment>

    <fragment
        android:id="@+id/addPlan"
        android:name="com.desynatadmin.ui.home.subscriptionPlan.AddPlanFragment"
        android:label="Add Plan Fragment"
        tools:layout="@layout/fragment_add_plan"/>

    <fragment
        android:id="@+id/category"
        android:name="com.desynatadmin.ui.home.categorySubCategoryManagement.CategoryFragment"
        android:label="Category Fragment"
        tools:layout="@layout/fragment_category">

        <action
            android:id="@+id/action_category_to_subcategoryFragment"
            app:destination="@id/subcategory" />

    </fragment>

    <fragment
        android:id="@+id/subcategory"
        android:name="com.desynatadmin.ui.home.categorySubCategoryManagement.SubCategoryFragment"
        android:label="Sub Category Fragment"
        tools:layout="@layout/fragment_sub_category">

        <action
            android:id="@+id/action_subcategory_to_subCategoryDetailFragment"
            app:destination="@id/subCategoryDetail" />

        <action
            android:id="@+id/action_subcategory_to_addSubCategoryFragment"
            app:destination="@id/addSubCategory" />

    </fragment>

    <fragment
        android:id="@+id/subCategoryDetail"
        android:name="com.desynatadmin.ui.home.categorySubCategoryManagement.SubCategoryDetailFragment"
        android:label="Sub Category Fragment"
        tools:layout="@layout/fragment_sub_category_detail">

        <action
            android:id="@+id/action_subCategoryDetail_to_addSubCategoryFragment"
            app:destination="@id/addSubCategory" />

    </fragment>

    <fragment
        android:id="@+id/addSubCategory"
        android:name="com.desynatadmin.ui.home.categorySubCategoryManagement.AddSubCategoryFragment"
        android:label="Add Sub Category Fragment"
        tools:layout="@layout/fragment_add_sub_category"/>

    <fragment
        android:id="@+id/brand"
        android:name="com.desynatadmin.ui.home.brandManagement.BrandManagementFragment"
        android:label="Brand Fragment"
        tools:layout="@layout/fragment_brand_management">

        <action
            android:id="@+id/action_brandFragment_to_brandDetailFragment"
            app:destination="@id/brandDetail" />

        <action
            android:id="@+id/action_brandFragment_to_addBrandFragment"
            app:destination="@id/addBrand" />

    </fragment>

    <fragment
        android:id="@+id/brandDetail"
        android:name="com.desynatadmin.ui.home.brandManagement.BrandDetailFragment"
        android:label="Brand Detail Fragment"
        tools:layout="@layout/fragment_brand_detail">

        <action
            android:id="@+id/action_brandDetail_to_addBrandFragment"
            app:destination="@id/addBrand" />

    </fragment>

    <fragment
        android:id="@+id/addBrand"
        android:name="com.desynatadmin.ui.home.brandManagement.AddBrandFragment"
        android:label="Add Brand Fragment"
        tools:layout="@layout/fragment_add_brand"/>

    <fragment
        android:id="@+id/reason"
        android:name="com.desynatadmin.ui.home.reasonManagement.ReasonManagementFragment"
        android:label="Reason Fragment"
        tools:layout="@layout/fragment_reason_management"/>


    <fragment
        android:id="@+id/user"
        android:name="com.desynatadmin.ui.home.userManagement.UserManagementFragment"
        android:label="User Fragment"
        tools:layout="@layout/fragment_user_management">

        <action
            android:id="@+id/action_userFragment_to_userDetailFragment"
            app:destination="@id/userDetail" />

    </fragment>

    <fragment
        android:id="@+id/userDetail"
        android:name="com.desynatadmin.ui.home.userManagement.UserDetailFragment"
        android:label="User Detail Fragment"
        tools:layout="@layout/fragment_user_detail">

    </fragment>

    <fragment
        android:id="@+id/deliveryBoy"
        android:name="com.desynatadmin.ui.home.deliveryBoyManagement.DeliveryBoyManagementFragment"
        android:label="Delivery Boy Management Fragment"
        tools:layout="@layout/fragment_delivery_boy_management">


        <action
            android:id="@+id/action_deliveryBoyFragment_to_deliveryBoyDetailFragment"
            app:destination="@id/deliveryBoyDetail" />

        <action
            android:id="@+id/action_deliveryBoyFragment_to_addDeliveryBoyFragment"
            app:destination="@id/addDeliveryBoy" />

    </fragment>

    <fragment
        android:id="@+id/deliveryBoyDetail"
        android:name="com.desynatadmin.ui.home.deliveryBoyManagement.DeliveryBoyDetailFragment"
        android:label="Delivery Boy Detail Fragment"
        tools:layout="@layout/fragment_delivery_boy_detail">

        <action
            android:id="@+id/action_deliveryBoyDetailFragment_to_addDeliveryBoyFragment"
            app:destination="@id/addDeliveryBoy" />

    </fragment>

    <fragment
        android:id="@+id/addDeliveryBoy"
        android:name="com.desynatadmin.ui.home.deliveryBoyManagement.AddDeliveryBoyFragment"
        android:label="Add Delivery Boy Fragment"
        tools:layout="@layout/fragment_add_delivery_boy"/>



    <fragment
        android:id="@+id/giftCard"
        android:name="com.desynatadmin.ui.home.giftCardManagement.GiftCardManagementFragment"
        android:label="Gift Card Fragment"
        tools:layout="@layout/fragment_gift_card_management">

        <action
            android:id="@+id/action_giftCardFragment_to_giftCardDetailFragment"
            app:destination="@id/giftCardDetail" />

        <action
            android:id="@+id/action_giftCardFragment_to_addGiftCardFragment"
            app:destination="@id/addGiftCard" />

    </fragment>

    <fragment
        android:id="@+id/giftCardDetail"
        android:name="com.desynatadmin.ui.home.giftCardManagement.GiftCardDetailFragment"
        android:label="Gift Card Detail Fragment"
        tools:layout="@layout/fragment_gift_card_detail">

        <action
            android:id="@+id/action_giftCardDetailDetail_to_addGiftCardFragment"
            app:destination="@id/addGiftCard" />

    </fragment>

    <fragment
        android:id="@+id/addGiftCard"
        android:name="com.desynatadmin.ui.home.giftCardManagement.AddGiftCardFragment"
        android:label="Add Gift Card Fragment"
        tools:layout="@layout/fragment_add_gift_card"/>

    <fragment
        android:id="@+id/promoCode"
        android:name="com.desynatadmin.ui.home.promoCodeManagement.PromoCodeManagementFragment"
        android:label="Promo Code Fragment"
        tools:layout="@layout/fragment_promo_code_management">

        <action
            android:id="@+id/action_promoCodeFragment_to_promoCodeDetailFragment"
            app:destination="@id/promoCodeDetail" />

        <action
            android:id="@+id/action_promoCodeFragment_to_addPromoCodeFragment"
            app:destination="@id/addPromoCode" />

    </fragment>

    <fragment
        android:id="@+id/promoCodeDetail"
        android:name="com.desynatadmin.ui.home.promoCodeManagement.PromoCodeDetailFragment"
        android:label="Promo Code Detail Fragment"
        tools:layout="@layout/fragment_promo_code_detail">

        <action
            android:id="@+id/action_promoCodeDetail_to_addPromoCodeFragment"
            app:destination="@id/addPromoCode" />

    </fragment>

    <fragment
        android:id="@+id/addPromoCode"
        android:name="com.desynatadmin.ui.home.promoCodeManagement.AddPromoCodeFragment"
        android:label="Add Promo Code Fragment"
        tools:layout="@layout/fragment_add_promo_code"/>


    <fragment
        android:id="@+id/shippingTax"
        android:name="com.desynatadmin.ui.home.shippingAndTaxManagement.ShippingManagementFragment"
        android:label="Shipping Tax Fragment"
        tools:layout="@layout/fragment_shipping_management">

        <action
            android:id="@+id/action_shippingTax_to_shippingChargeFragment"
            app:destination="@id/shippingCharge" />

    </fragment>

    <fragment
        android:id="@+id/shippingCharge"
        android:name="com.desynatadmin.ui.home.shippingAndTaxManagement.ShippingChargesFragment"
        android:label="Shipping Charge Fragment"
        tools:layout="@layout/fragment_shipping_charges"/>

    <fragment
        android:id="@+id/bannerPerDayPrice"
        android:name="com.desynatadmin.ui.home.banner.BannerPerDayPriceFragment"
        android:label="Banner Per Day Price Fragment"
        tools:layout="@layout/fragment_banner_per_day_price"/>

</navigation>