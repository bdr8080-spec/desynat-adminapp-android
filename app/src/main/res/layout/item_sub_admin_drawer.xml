<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_15sdp"
    android:paddingVertical="@dimen/_5sdp"
    android:layout_marginBottom="@dimen/_10sdp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivDrawer"
            style="@style/drawer_image"
            android:src="@drawable/ic_category_management" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDrawer"
            style="@style/drawer_text"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_toStartOf="@+id/ivGoDrawer"
            android:layout_toEndOf="@id/ivDrawer"
            android:text="Category &amp; Sub- Category Management" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivGoDrawer"
            style="@style/drawer_arrow" />

</RelativeLayout>