<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bottomsheet_bg"
    android:layout_height="wrap_content"
    android:paddingBottom="42dp"
    >
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add New City"
        android:padding="16dp"
        android:background="@drawable/bottomsheet_bg"
        android:backgroundTint="#FFF7EA"
        android:drawableEnd="@drawable/close_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCountry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="45dp"
        android:text="Select City"
        android:textSize="12dp"
        android:layout_marginHorizontal="16dp"
        android:fontFamily="@font/poppins_medium"
        android:textColor="#000000"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDropdown"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/dropdwn_bg"
        android:drawableEnd="@drawable/down_ic"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:text="India"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCountry" />
    
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/btn1_background"
        app:layout_constraintTop_toBottomOf="@id/tvDropdown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="60dp"
        android:text="Submit"
        android:gravity="center"
        android:textColor="#FAFAFA"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_medium"
        />

</androidx.constraintlayout.widget.ConstraintLayout>