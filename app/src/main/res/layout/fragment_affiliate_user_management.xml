<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.home.affiliateUserManagement.AffiliateUserManagementFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/ivBackArrow">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clSearch"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:background="@drawable/search_bg"
                    android:layout_marginTop="@dimen/_10sdp">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:background="@null"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="10dp"
                        android:ellipsize="end"
                        android:hint="@string/search"
                        android:paddingStart="12dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="#5B6163"
                        android:textSize="@dimen/_11sdp"
                        android:textAlignment="viewStart"
                        android:layout_marginEnd="@dimen/_10sdp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivFilter" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_margin="1dp"
                        android:background="@drawable/filter_bg"
                        android:paddingHorizontal="@dimen/_15sdp"
                        android:src="@drawable/filter_ic"
                        app:layout_constraintTop_toTopOf="@id/etSearch"
                        app:layout_constraintBottom_toBottomOf="@id/etSearch"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnExport"
                    style="@style/button"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/button_stroke"
                    android:text="@string/export"
                    android:textColor="@color/brown"
                    android:padding="@dimen/_6sdp"
                    app:layout_constraintTop_toBottomOf="@id/etSearch"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llTab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    app:layout_constraintTop_toBottomOf="@+id/btnExport">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvNew"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/new_text"
                        android:textColor="#875C3A"
                        android:textSize="@dimen/_11sdp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:layout_marginTop="@dimen/_15sdp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tvApproved"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <View
                        android:id="@+id/viewNew"
                        android:layout_width="0dp"
                        android:layout_height="1.5dp"
                        android:background="#875C3A"
                        app:layout_constraintTop_toBottomOf="@+id/tvNew"
                        app:layout_constraintStart_toStartOf="@+id/tvNew"
                        app:layout_constraintEnd_toEndOf="@+id/tvNew"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvApproved"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/approved"
                        android:textColor="#C0BBBB"
                        android:textSize="@dimen/_11sdp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semi_bold"
                        app:layout_constraintStart_toEndOf="@+id/tvNew"
                        app:layout_constraintEnd_toStartOf="@+id/tvRejected"
                        app:layout_constraintTop_toTopOf="@+id/tvNew"/>

                    <View
                        android:id="@+id/viewApproved"
                        android:layout_width="0dp"
                        android:layout_height="1.5dp"
                        android:background="#C0BBBB"
                        app:layout_constraintTop_toBottomOf="@+id/tvApproved"
                        app:layout_constraintStart_toStartOf="@+id/tvApproved"
                        app:layout_constraintEnd_toEndOf="@+id/tvApproved"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvRejected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/rejected"
                        android:textColor="#C0BBBB"
                        android:textSize="@dimen/_11sdp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semi_bold"
                        app:layout_constraintStart_toEndOf="@+id/tvApproved"
                        app:layout_constraintTop_toTopOf="@+id/tvApproved"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <View
                        android:id="@+id/viewRejected"
                        android:layout_width="0dp"
                        android:layout_height="1.5dp"
                        android:background="#C0BBBB"
                        app:layout_constraintTop_toBottomOf="@+id/tvRejected"
                        app:layout_constraintStart_toStartOf="@+id/tvRejected"
                        app:layout_constraintEnd_toEndOf="@+id/tvRejected"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAffiliateUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    tools:listitem="@layout/item_affiliate_user"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_20sdp"/>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBackArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_25sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/ic_back_brand_disable"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="01 of 01"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/black"
        android:textSize="@dimen/_12sdp"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="@+id/ivBackArrow"
        app:layout_constraintBottom_toBottomOf="@+id/ivBackArrow"
        app:layout_constraintStart_toEndOf="@+id/ivBackArrow"
        app:layout_constraintEnd_toStartOf="@+id/ivNextArrow"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivNextArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingBottom="@dimen/_25sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/ic_next_brand"/>

    <ProgressBar
        android:visibility="gone"
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:indeterminate="true"
        android:indeterminateTint="@color/brown" />

    <androidx.appcompat.widget.AppCompatTextView
        android:visibility="gone"
        android:id="@+id/tvNoDataFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_50sdp"
        android:textColor="@color/black"
        android:fontFamily="@font/poppins_medium"
        android:textSize="@dimen/_13sdp"
        android:text="No data found"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>