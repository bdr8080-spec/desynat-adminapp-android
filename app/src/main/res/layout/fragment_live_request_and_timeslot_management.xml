<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.liveRequestAndTimeSlotManagement.LiveRequestAndTimeslotManagementFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_30sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_ic"
            android:paddingVertical="@dimen/_15sdp"
            android:paddingStart="@dimen/_15sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvToolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="Live Request &amp; Timeslot Management"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_5sdp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/ivBackArrow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:weightSum="2"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/tab"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvLiveRequestTimeslot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Live Request Timeslot"
                    android:background="@drawable/selected_left_border"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvLiveRequest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Live Request"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="gone"
                android:id="@+id/clSearch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/search_bg"
                android:layout_marginTop="@dimen/_15sdp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:ellipsize="end"
                    android:hint="Search"
                    android:paddingStart="12dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="#5B6163"
                    android:textSize="@dimen/_11sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivFilter" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivFilter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/filter_bg"
                    android:padding="16dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/filter_ic"
                    app:layout_constraintTop_toTopOf="@id/etSearch"
                    app:layout_constraintBottom_toBottomOf="@id/etSearch"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCountry"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Choose Country"
                android:textSize="@dimen/_12sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/card_stroke_background"
                android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etCountry"
                style="@style/edit_text"
                android:paddingVertical="@dimen/_9sdp"
                android:drawablePadding="@dimen/_5sdp"
                android:hint="Select Country"
                android:editable="false"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_centerVertical="true"
                android:background="@null"
                android:drawableEnd="@drawable/ic_drop_down"/>

              <!--  <View
                    android:visibility="gone"
                    android:id="@+id/viewCountry"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1A000000"/>

            <androidx.recyclerview.widget.RecyclerView
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/etCountry"
                android:elevation="3dp"
                android:layout_marginTop="@dimen/_10sdp"
                tools:itemCount="7"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:id="@+id/rvCountry"
                tools:listitem="@layout/country_recyler" />-->

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTimeSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_15sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/_15sdp"
                        android:paddingVertical="@dimen/_10sdp"
                        android:background="@drawable/calender_top">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvSelectDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Select date for live"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_13sdp"
                            android:fontFamily="@font/poppins_medium"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvCalendarDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Mon , Nov 17"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_18sdp"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:layout_marginTop="@dimen/_5sdp"
                            app:layout_constraintTop_toBottomOf="@+id/tvSelectDate"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layoutMonthHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvMonthYear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="November 2025"
                                android:paddingVertical="@dimen/_10sdp"
                                android:paddingHorizontal="@dimen/_15sdp"
                                android:textSize="@dimen/_11sdp"
                                android:textColor="@color/black"
                                android:drawablePadding="@dimen/_10sdp"
                                android:drawableEnd="@drawable/calendar_down_arrow"
                                android:fontFamily="@font/poppins_medium"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"/>

                            <ImageView
                                android:id="@+id/ivPrevious"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingVertical="@dimen/_10sdp"
                                android:paddingHorizontal="@dimen/_15sdp"
                                android:src="@drawable/calendar_previous_arrow"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/ivNext"/>

                            <ImageView
                                android:id="@+id/ivNext"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingVertical="@dimen/_10sdp"
                                android:paddingHorizontal="@dimen/_15sdp"
                                android:src="@drawable/calendar_next_arrow"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/_5sdp"
                            android:paddingTop="@dimen/_5sdp">

                            <TextView style="@style/WeekDayText" android:text="S"/>
                            <TextView style="@style/WeekDayText" android:text="M"/>
                            <TextView style="@style/WeekDayText" android:text="T"/>
                            <TextView style="@style/WeekDayText" android:text="W"/>
                            <TextView style="@style/WeekDayText" android:text="T"/>
                            <TextView style="@style/WeekDayText" android:text="F"/>
                            <TextView style="@style/WeekDayText" android:text="S"/>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvCalendar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_5sdp"
                            tools:listitem="@layout/item_calendar_day"
                            tools:itemCount="30"
                            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                            app:spanCount="7"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvSelectedDateToSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today, 1st January 2025"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_medium"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:visibility="gone"
                    android:id="@+id/tvNoSlots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_20sdp"
                   android:paddingVertical="@dimen/_50sdp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_13sdp"
                    android:text="No Slots Available" />

                <androidx.recyclerview.widget.RecyclerView
                    android:visibility="visible"
                    android:id="@+id/rvTimeSlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="@dimen/_10sdp"
                    tools:itemCount="3"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    tools:listitem="@layout/item_time_slot"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llLiveRequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llTab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    app:layout_constraintTop_toBottomOf="@+id/llOrderType">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvNew"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="New"
                        android:textColor="#875C3A"
                        android:textSize="@dimen/_12sdp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:layout_marginTop="@dimen/_15sdp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tvApproved"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <View
                        android:id="@+id/viewNew"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:background="#875C3A"
                        app:layout_constraintTop_toBottomOf="@+id/tvNew"
                        app:layout_constraintStart_toStartOf="@+id/tvNew"
                        app:layout_constraintEnd_toEndOf="@+id/tvNew"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvApproved"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Approved"
                        android:textColor="#C0BBBB"
                        android:textSize="@dimen/_12sdp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semi_bold"
                        app:layout_constraintStart_toEndOf="@+id/tvNew"
                        app:layout_constraintEnd_toStartOf="@+id/tvRejected"
                        app:layout_constraintTop_toTopOf="@+id/tvNew"/>

                    <View
                        android:id="@+id/viewApproved"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:background="#C0BBBB"
                        app:layout_constraintTop_toBottomOf="@+id/tvApproved"
                        app:layout_constraintStart_toStartOf="@+id/tvApproved"
                        app:layout_constraintEnd_toEndOf="@+id/tvApproved"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvRejected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Rejected"
                        android:textColor="#C0BBBB"
                        android:textSize="@dimen/_12sdp"
                        android:gravity="end"
                        android:fontFamily="@font/poppins_semi_bold"
                        app:layout_constraintStart_toEndOf="@+id/tvApproved"
                        app:layout_constraintTop_toTopOf="@+id/tvApproved"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <View
                        android:id="@+id/viewRejected"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:background="#C0BBBB"
                        app:layout_constraintTop_toBottomOf="@+id/tvRejected"
                        app:layout_constraintStart_toStartOf="@+id/tvRejected"
                        app:layout_constraintEnd_toEndOf="@+id/tvRejected"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:visibility="gone"
                    android:id="@+id/tvNoDataFound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_100sdp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_13sdp"
                    android:text="No data found" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLiveRequest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    tools:listitem="@layout/item_live_request"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_70sdp"/>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnAddTimeSlot"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                style="@style/button"
                android:text="Add timeslot"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatImageView
        android:visibility="gone"
        android:id="@+id/ivBackArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_25sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/ic_back_brand_disable"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:visibility="gone"
        android:id="@+id/tvCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="01 of 01"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/black"
        android:textSize="@dimen/_12sdp"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="@+id/ivBackArrow"
        app:layout_constraintBottom_toBottomOf="@+id/ivBackArrow"
        app:layout_constraintStart_toEndOf="@+id/ivBackArrow"
        app:layout_constraintEnd_toStartOf="@+id/ivNextArrow"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:visibility="gone"
        android:id="@+id/ivNextArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingBottom="@dimen/_25sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/ic_next_brand"/>

    <ProgressBar
        android:visibility="gone"
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:indeterminate="true"
        android:indeterminateTint="@color/brown" />

</androidx.constraintlayout.widget.ConstraintLayout>