<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/_15sdp"
    android:layout_marginBottom="@dimen/_15sdp"
    android:paddingBottom="@dimen/_6sdp"
    android:background="@drawable/card_stroke_background"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivStore"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_110sdp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:src="@drawable/ic_placeholder"
        app:shapeAppearanceOverlay="@style/half_rounded_corner_10sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:visibility="gone"
        android:id="@+id/ivSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/switch_on"
        android:padding="@dimen/_5sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:singleLine="true"
        android:text="Levis Shirt"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_1sdp"
        android:textSize="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_5sdp"
        app:layout_constraintStart_toStartOf="@+id/ivStore"
        app:layout_constraintEnd_toEndOf="@+id/ivStore"
        app:layout_constraintTop_toBottomOf="@+id/ivStore" />

    <TextView
        android:id="@+id/tvProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:fontFamily="@font/poppins_light"
        android:maxLines="1"
        android:layout_marginTop="@dimen/_1sdp"
        android:text="Levis Mens cotton shirt"
        android:textColor="@color/black"
        android:textSize="@dimen/_9sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvBrand"
        app:layout_constraintStart_toStartOf="@+id/ivStore"
        app:layout_constraintEnd_toEndOf="@+id/ivStore"/>

    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:fontFamily="@font/poppins_regular"
        android:maxLines="1"
        android:layout_marginTop="@dimen/_1sdp"
        android:text="Men (Shirt)"
        android:textColor="@color/black"
        android:textSize="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvProductName"
        app:layout_constraintStart_toStartOf="@+id/ivStore"
        app:layout_constraintEnd_toEndOf="@+id/ivStore"/>

    <TextView
        android:id="@+id/tvDiscountPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:maxLines="1"
        android:layout_marginTop="@dimen/_1sdp"
        android:text="KD 239"
        android:textColor="@color/brown"
        android:textSize="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintStart_toEndOf="@+id/tvPrice"
        app:layout_constraintTop_toBottomOf="@+id/tvCategory" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:maxLines="1"
        android:layout_marginTop="@dimen/_1sdp"
        android:text="KD 239"
        android:textColor="#99000000"
        android:textSize="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_5sdp"
        app:layout_constraintStart_toStartOf="@+id/ivStore"
        app:layout_constraintTop_toBottomOf="@+id/tvCategory" />

    <View
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="#99000000"
        app:layout_constraintStart_toStartOf="@+id/tvPrice"
        app:layout_constraintEnd_toEndOf="@+id/tvPrice"
        app:layout_constraintTop_toTopOf="@+id/tvPrice"
        app:layout_constraintBottom_toBottomOf="@+id/tvPrice"/>

    <TextView
        android:id="@+id/tvDiscount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_3sdp"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_regular"
        android:maxLines="1"
        android:text="20% off"
        android:textColor="#E70000"
        android:textSize="@dimen/_8sdp"
        app:layout_constraintStart_toEndOf="@+id/tvDiscountPrice"
        app:layout_constraintTop_toTopOf="@+id/tvPrice"
        app:layout_constraintBottom_toBottomOf="@+id/tvPrice"/>


</androidx.constraintlayout.widget.ConstraintLayout>