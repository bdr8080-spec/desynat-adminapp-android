<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottomsheet_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottomsheet_bg"
        android:backgroundTint="#FFF7EA"
        android:drawableEnd="@drawable/close_icon"
        android:fontFamily="@font/poppins_medium"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingVertical="@dimen/_15sdp"
        android:text="Add FAQ"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="Question"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="In English"
            android:layout_alignParentEnd="true"
            android:textColor="#80000000"
            android:textSize="@dimen/_10sdp"/>

    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etEnglishQuestion"
        style="@style/edit_text"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@drawable/edit_back"
        android:hint="Enter Question"
        android:inputType="textCapSentences"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="Question"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="In Arabic"
            android:layout_alignParentEnd="true"
            android:textColor="#80000000"
            android:textSize="@dimen/_10sdp"/>

    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etArabicQuestion"
        style="@style/edit_text"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@drawable/edit_back"
        android:hint="Enter Question"
        android:inputType="textCapSentences"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="Answer"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="In English"
            android:layout_alignParentEnd="true"
            android:textColor="#80000000"
            android:textSize="@dimen/_10sdp"/>

    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etEnglishAnswer"
        style="@style/edit_text"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@drawable/edit_back"
        android:hint="Enter Answer"
        android:minLines="1"
        android:maxLines="10"
        android:inputType="textMultiLine"
        android:gravity="start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="Answer"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="In Arabic"
            android:layout_alignParentEnd="true"
            android:textColor="#80000000"
            android:textSize="@dimen/_10sdp"/>

    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etArabicAnswer"
        style="@style/edit_text"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@drawable/edit_back"
        android:hint="Enter Answer"
        android:minLines="1"
        android:maxLines="10"
        android:inputType="textMultiLine"
        android:gravity="start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnAdd"
        style="@style/button"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:text="Add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relContact" />

</LinearLayout>


