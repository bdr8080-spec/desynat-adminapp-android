<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.fullScreenBannerManagement.AddPromotionalBannerFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/_15sdp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clPlaceholder"
                android:layout_width="0dp"
                android:layout_height="@dimen/_120sdp"
                app:layout_constraintTop_toTopOf="@+id/ivBanner"
                app:layout_constraintBottom_toBottomOf="@+id/ivBanner"
                app:layout_constraintStart_toStartOf="@+id/ivBanner"
                app:layout_constraintEnd_toEndOf="@+id/ivBanner">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPlaceholder"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:src="@drawable/add_delivery_boy_placeholder"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/tvPlaceholder"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPlaceholder"
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:textColor="#875C3A"
                    android:text="@string/upload_banner"
                    android:textAlignment="center"
                    android:textSize="@dimen/_11sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivPlaceholder"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivBanner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_120sdp"
                android:scaleType="centerCrop"
                android:background="@drawable/ic_dash"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvCountry"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/select_country" />

            <androidx.appcompat.widget.AppCompatEditText
                android:visibility="gone"
                android:id="@+id/etCountry"
                style="@style/edit_text"
                android:paddingVertical="@dimen/_9sdp"
                android:drawablePadding="@dimen/_5sdp"
                android:hint="@string/select_country"
                android:editable="false"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginTop="5dp"
                android:layout_centerVertical="true"
                android:drawableEnd="@drawable/ic_drop_down"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPosition"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/position" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etPosition"
                style="@style/edit_text"
                android:paddingVertical="@dimen/_9sdp"
                android:drawablePadding="@dimen/_5sdp"
                android:hint="@string/select_position"
                android:editable="false"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginTop="5dp"
                android:textAlignment="viewStart"
                android:layout_centerVertical="true"
                android:drawableEnd="@drawable/ic_drop_down"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvCategory"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/select_category" />

            <RadioGroup
                android:visibility="gone"
                android:id="@+id/rgCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="3"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/etFrom">

                <RadioButton
                    android:id="@+id/rbMen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/men"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_home_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/rbWomen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/women"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_home_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/rbKids"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/kids"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_home_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvSubCategory"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/sub_category" />

            <androidx.appcompat.widget.AppCompatEditText
                android:visibility="gone"
                android:id="@+id/etSubCategory"
                style="@style/edit_text"
                android:paddingVertical="@dimen/_9sdp"
                android:drawablePadding="@dimen/_5sdp"
                android:hint="@string/select_sub_category"
                android:editable="false"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginTop="5dp"
                android:layout_centerVertical="true"
                android:drawableEnd="@drawable/ic_drop_down"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStartDate"
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/duration"
                    android:layout_marginEnd="@dimen/_7sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/etStartDate"
                    style="@style/edit_text"
                    android:layout_width="0dp"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="5dp"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_calendar"
                    android:drawablePadding="@dimen/_5sdp"
                    android:editable="false"
                    android:focusable="false"
                    android:hint="@string/from_date_hint"
                    android:paddingVertical="@dimen/_9sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toStartOf="@+id/etEndDate"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvStartDate" />

                <TextView
                    android:id="@+id/etEndDate"
                    style="@style/edit_text"
                    android:layout_width="0dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_calendar"
                    android:drawablePadding="@dimen/_5sdp"
                    android:editable="false"
                    android:focusable="false"
                    android:hint="@string/to_date_hint"
                    android:textAlignment="viewStart"
                    android:paddingVertical="@dimen/_9sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/etStartDate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/etStartDate"
                    app:layout_constraintTop_toTopOf="@+id/etStartDate" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="gone"
                android:id="@+id/clDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_stroke_background"
                app:layout_constraintTop_toBottomOf="@+id/etFrom"
                android:layout_marginTop="@dimen/_15sdp"
                android:padding="@dimen/_10sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:text="@string/total_days"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTotalDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:text=""
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvDays"
                    app:layout_constraintBottom_toBottomOf="@+id/tvDays"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_30sdp"
                style="@style/button"
                android:text="@string/submit"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>