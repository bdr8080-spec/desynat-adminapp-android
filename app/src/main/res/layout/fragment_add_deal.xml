<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.home.dealsManagement.AddDealFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/_15sdp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDeal"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_120sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_upload_deal_img"
                android:background="@drawable/ic_dash"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="Full Name"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="In English"
                    android:layout_alignParentEnd="true"
                    android:textColor="#80000000"
                    android:textSize="@dimen/_10sdp"/>

            </RelativeLayout>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etEnglishFullName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter Full Name"
                android:inputType="text"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:text="Full Name"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:text="In Arabic"
                    android:layout_alignParentEnd="true"
                    android:textColor="#80000000"
                    android:textSize="@dimen/_10sdp"/>

            </RelativeLayout>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etArabicFullName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter Full Name"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="text"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="Select Category"
                android:textSize="@dimen/_12sdp"/>

            <RadioGroup
                android:id="@+id/rgCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="3"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/etFrom">

                <RadioButton
                    android:id="@+id/rbMen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Men"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_home_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/rbWomen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Women"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_home_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/rbKids"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kids"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_home_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="Sub-Category"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSubCategory"
                style="@style/edit_text"
                android:paddingVertical="@dimen/_9sdp"
                android:drawablePadding="@dimen/_5sdp"
                android:hint="Select Sub-Category"
                android:editable="false"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginTop="5dp"
                android:layout_centerVertical="true"
                android:drawableEnd="@drawable/ic_drop_down"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:text="Discount"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:text="In Percentage"
                    android:layout_alignParentEnd="true"
                    android:textColor="#80000000"
                    android:textSize="@dimen/_10sdp"/>

            </RelativeLayout>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDiscount"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter discount"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="numberDecimal"
                android:maxLength="4"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:text="Date"
                android:layout_marginTop="@dimen/_15sdp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etFromDate"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="From // //"
                android:layout_marginTop="@dimen/_5sdp"
                android:editable="false"
                android:focusable="false"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_calendar"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etToDate"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="To // //"
                android:layout_marginTop="@dimen/_15sdp"
                android:editable="false"
                android:focusable="false"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_calendar"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                style="@style/button"
                android:text="Submit" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>