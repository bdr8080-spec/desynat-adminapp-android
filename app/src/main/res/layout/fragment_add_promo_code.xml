<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.promoCodeManagement.AddPromoCodeFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCountry"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Select Country"
                android:textSize="@dimen/_13sdp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etCountry"
                style="@style/edit_text"
                android:paddingVertical="@dimen/_9sdp"
                android:drawablePadding="@dimen/_5sdp"
                android:hint="Select"
                android:editable="false"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginTop="5dp"
                android:layout_centerVertical="true"
                android:drawableEnd="@drawable/ic_drop_down"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="Promocode Name (English)"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etEnglishPromoCode"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter promocode name"
                android:inputType="text"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="Promocode Name (Arabic)"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etArabicPromoCode"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter promocode name"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="text"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="Description (English)"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etEnglishDescription"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter description"
                android:inputType="text"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="Description (Arabic)"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etArabicDescription"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter description"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="text"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="Applicable for"/>

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbFirst"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First Order"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/rbEvery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Every Order"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Discount %"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDiscount"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter discount"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="number"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Minimum Order Value"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMinimumOrderValue"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter minimum order value"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="number"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Up to Discount"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etUpToDiscount"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter Up to Discount"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="number"
                android:background="@drawable/edit_back" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStartDate"
                    style="@style/edit_text_title"
                    android:layout_width="0dp"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="Start Date"
                    android:textSize="@dimen/_13sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvEndDate"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvEndDate"
                    style="@style/edit_text_title"
                    android:layout_width="0dp"
                    android:text="End Date"
                    android:textSize="@dimen/_13sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    app:layout_constraintStart_toEndOf="@+id/tvStartDate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvStartDate" />

                <TextView
                    android:id="@+id/etStartDate"
                    style="@style/edit_text"
                    android:layout_width="0dp"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="5dp"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_calendar"
                    android:drawablePadding="@dimen/_5sdp"
                    android:editable="false"
                    android:focusable="false"
                    android:hint="From   //  //"
                    android:paddingVertical="@dimen/_9sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    app:layout_constraintEnd_toStartOf="@+id/etEndDate"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvStartDate" />

                <TextView
                    android:id="@+id/etEndDate"
                    style="@style/edit_text"
                    android:layout_width="0dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_calendar"
                    android:drawablePadding="@dimen/_5sdp"
                    android:editable="false"
                    android:focusable="false"
                    android:hint="To   //  //"
                    android:paddingVertical="@dimen/_9sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/etStartDate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/etStartDate"
                    app:layout_constraintTop_toTopOf="@+id/etStartDate" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                style="@style/button"
                android:text="Submit" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>