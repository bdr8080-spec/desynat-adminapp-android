<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottomsheet_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottomsheet_bg"
        android:backgroundTint="#FFF7EA"
        android:drawableEnd="@drawable/close_icon"
        android:fontFamily="@font/poppins_medium"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingVertical="@dimen/_15sdp"
        android:text="@string/terms_and_conditions"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:id="@+id/relEnglish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleEnglish"
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="@string/terms_and_conditions"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:visibility="gone"
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="@string/in_english"
            android:layout_alignParentEnd="true"
            android:textColor="#80000000"
            android:textSize="@dimen/_10sdp"/>

    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etEnglishDescription"
        style="@style/edit_text"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@drawable/edit_back"
        android:hint="@string/enter_terms_and_condition"
        android:inputType="textMultiLine"
        android:textSize="@dimen/_11sdp"
        android:minLines="1"
        android:maxLines="5"/>

    <RelativeLayout
        android:id="@+id/relArabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleArabic"
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="@string/terms_and_conditions"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:visibility="gone"
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:text="@string/in_arabic"
            android:layout_alignParentEnd="true"
            android:textColor="#80000000"
            android:textSize="@dimen/_10sdp"/>

    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etArabicDescription"
        style="@style/edit_text"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@drawable/edit_back"
        android:hint="@string/enter_terms_and_condition"
        android:inputType="textMultiLine"
        android:textSize="@dimen/_11sdp"
        android:minLines="1"
        android:maxLines="5"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnSave"
        style="@style/button"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:text="@string/save_changes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relContact" />

</LinearLayout>


