<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.brandManagement.AddBrandFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/btnSubmit">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/_15sdp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clPlaceholder"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_120sdp"
                        app:layout_constraintTop_toTopOf="@+id/ivBrand"
                        app:layout_constraintBottom_toBottomOf="@+id/ivBrand"
                        app:layout_constraintStart_toStartOf="@+id/ivBrand"
                        app:layout_constraintEnd_toEndOf="@+id/ivBrand">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivPlaceholder"
                            android:layout_width="@dimen/_35sdp"
                            android:layout_height="@dimen/_35sdp"
                            android:layout_gravity="center_horizontal"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true"
                            android:src="@drawable/ic_gallery_placeholder_gradient"
                            app:layout_constraintVertical_chainStyle="packed"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@+id/tvPlaceholder"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvPlaceholder"
                            style="@style/edit_text_title"
                            android:layout_width="wrap_content"
                            android:textColor="#875C3A"
                            android:text="@string/upload_image"
                            android:textAlignment="center"
                            android:textSize="@dimen/_11sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            app:layout_constraintVertical_chainStyle="packed"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/ivPlaceholder"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivBrand"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_120sdp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/ic_dash"
                        app:layout_constraintStart_toStartOf="parent"
                       app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"/>


                </androidx.constraintlayout.widget.ConstraintLayout>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="@string/brand_name"
                        android:textAlignment="viewStart"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="@string/in_english"
                        android:layout_alignParentEnd="true"
                        android:textColor="#80000000"
                        android:textSize="@dimen/_10sdp"/>

                </RelativeLayout>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etEnglishBrandName"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/enter_brand_name"
                    android:inputType="text"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:textAlignment="viewStart"
                    android:background="@drawable/edit_back" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="@string/brand_name"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="@string/in_arabic"
                        android:layout_alignParentEnd="true"
                        android:textColor="#80000000"
                        android:textSize="@dimen/_10sdp"/>

                </RelativeLayout>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etArabicBrandName"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/enter_brand_name"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="text"
                    android:textAlignment="viewStart"
                    android:background="@drawable/edit_back" />


            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnSubmit"
        android:layout_width="0dp"
       app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
       android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_30sdp"
        style="@style/button"
        android:text="@string/submit" />

</androidx.constraintlayout.widget.ConstraintLayout>