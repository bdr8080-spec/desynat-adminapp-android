<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.brandManagement.AddBrandFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/btnSubmit">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/_15sdp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivBrand"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_120sdp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_upload_brand"
                    android:background="@drawable/ic_dash"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvImage"
                    app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="@string/brand_name"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="@string/in_english"
                        android:layout_alignParentEnd="true"
                        android:textColor="#80000000"
                        android:textSize="@dimen/_10sdp"/>

                </RelativeLayout>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etEnglishBrandName"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/enter_brand_name"
                    android:inputType="text"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:textAlignment="viewStart"
                    android:background="@drawable/edit_back" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="@string/brand_name"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="@string/in_arabic"
                        android:layout_alignParentEnd="true"
                        android:textColor="#80000000"
                        android:textSize="@dimen/_10sdp"/>

                </RelativeLayout>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etArabicBrandName"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/enter_brand_name"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="text"
                    android:textAlignment="viewStart"
                    android:background="@drawable/edit_back" />


            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnSubmit"
        android:layout_width="0dp"
       app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
       android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_30sdp"
        style="@style/button"
        android:text="@string/submit" />

</androidx.constraintlayout.widget.ConstraintLayout>