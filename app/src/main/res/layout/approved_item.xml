<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/cl1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/et_bg"
    android:padding="8dp"
    android:layout_marginTop="10dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivProfileImage"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_user"
        app:layout_constraintStart_toStartOf="@+id/ivStoryHighlight"
        app:layout_constraintTop_toTopOf="@+id/ivStoryHighlight"
        app:layout_constraintBottom_toBottomOf="@+id/ivStoryHighlight"
        app:layout_constraintEnd_toEndOf="@+id/ivStoryHighlight"
        app:shapeAppearanceOverlay="@style/circle_image"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:visibility="invisible"
        android:id="@+id/ivStoryHighlight"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        app:strokeColor="@color/brown"
        android:padding="@dimen/_3sdp"
        app:shapeAppearanceOverlay="@style/circle_image"
        app:strokeWidth="@dimen/_3sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Alisha Khan"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivStoryHighlight"
        app:layout_constraintTop_toTopOf="@id/ivStoryHighlight" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/location_ic"
        android:drawablePadding="5dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Kuwait"
        android:textColor="@color/black"
        android:textSize="@dimen/_9sdp"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="@id/ivStoryHighlight"
        app:layout_constraintStart_toStartOf="@id/tvName"
        app:layout_constraintTop_toBottomOf="@id/tvName" />

    <View
        android:id="@+id/viewDivider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginStart="5dp"
        android:background="#0000001A"
        app:layout_constraintBottom_toBottomOf="@id/tvLocation"
        app:layout_constraintStart_toEndOf="@id/tvLocation"
        app:layout_constraintTop_toTopOf="@id/tvLocation" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvJoinedOn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Joined on 21/02/2025"
        android:textColor="@color/black"
        android:textSize="@dimen/_9sdp"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="@id/viewDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/viewDivider"
        app:layout_constraintTop_toTopOf="@id/viewDivider" />

    <View
        android:id="@+id/view1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="8dp"
        android:background="#1A000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivStoryHighlight" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:drawableStart="@drawable/phone_ic"
        android:drawablePadding="5dp"
        android:fontFamily="@font/poppins_regular"
        android:text="+965- 28392018391"
        android:textColor="#000000"
        android:textSize="@dimen/_9sdp"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toStartOf="@id/tvEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view1" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:drawableStart="@drawable/mail_ic"
        android:drawablePadding="5dp"
        android:fontFamily="@font/poppins_regular"
        android:text="alisha.khan@gmail.com"
        android:textColor="#000000"
        android:textSize="@dimen/_9sdp"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="@id/tvCall"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvCall"
        app:layout_constraintTop_toTopOf="@id/tvCall" />


    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="8dp"
        android:background="#1A000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEmail" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTotalOrdersLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/total_orders"
        android:textColor="#99000000"
        android:textSize="@dimen/_10sdp"
        android:layout_marginTop="8dp"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view2"
        app:layout_constraintEnd_toStartOf="@id/tvTotalEarningsLabel"
        />

    <!-- Total Earnings Label -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTotalEarningsLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/total_earnings"
        android:textColor="#99000000"
        android:textSize="@dimen/_10sdp"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toEndOf="@id/tvTotalOrdersLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTotalOrdersLabel"
        />

    <!-- Total Orders Value -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTotalOrdersValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_medium"
        android:text="0"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="@id/tvTotalOrdersLabel"
        app:layout_constraintTop_toBottomOf="@id/tvTotalOrdersLabel"
        app:layout_constraintEnd_toStartOf="@id/tvTotalEarningsValue"  />

    <!-- Total Earnings Value -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTotalEarningsValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/poppins_medium"
        android:text="KD 0"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toEndOf="@id/tvTotalOrdersValue"
        app:layout_constraintTop_toBottomOf="@id/tvTotalEarningsLabel"
        app:layout_constraintEnd_toEndOf="@id/tvTotalEarningsLabel" />


</androidx.constraintlayout.widget.ConstraintLayout>