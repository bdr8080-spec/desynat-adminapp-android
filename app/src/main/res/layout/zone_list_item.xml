<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/city_item_bg"
    android:paddingHorizontal="12dp"
    android:layout_marginBottom="16dp"
    >

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvZoneName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Zone 01"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="20dp"
        android:singleLine="true"
        app:layout_constraintEnd_toStartOf="@+id/tvViewZone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvViewZone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:background="@drawable/btn1_background"
        android:drawableStart="@drawable/eye"
        android:drawablePadding="5dp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center_vertical"
        android:layout_marginEnd="20dp"
        android:paddingHorizontal="8dp"
        android:text="View"
        android:textColor="@color/white"
        android:textSize="10sp"
        app:drawableTint="@color/white"
        app:layout_constraintBottom_toBottomOf="@id/tvZoneName"
        app:layout_constraintEnd_toStartOf="@id/imEdit"
        app:layout_constraintStart_toEndOf="@id/tvZoneName"
        app:layout_constraintTop_toTopOf="@id/tvZoneName" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:src="@drawable/edit_ic"
        app:layout_constraintBottom_toBottomOf="@id/imDelete"
        app:layout_constraintEnd_toStartOf="@id/imDelete"
        app:layout_constraintTop_toTopOf="@id/imDelete" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:src="@drawable/delete_ic"
        app:layout_constraintBottom_toBottomOf="@id/toggle"
        app:layout_constraintEnd_toStartOf="@id/toggle"
        app:layout_constraintTop_toTopOf="@id/toggle" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/toggle_ic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>