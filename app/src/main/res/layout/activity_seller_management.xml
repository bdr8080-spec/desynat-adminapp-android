<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.m2.SellerManagementActivity">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:drawableStart="@drawable/back_ic"
        android:fontFamily="@font/poppins_medium"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_15sdp"
        android:text="Country City &amp; Zone"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvToolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/search_bg"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:ellipsize="end"
                android:hint="Search"
                android:paddingStart="12dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="#5B6163"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/filter_bg"
                android:padding="16dp"
                android:scaleType="fitXY"
                android:src="@drawable/filter_ic"
                app:layout_constraintBottom_toBottomOf="@id/etSearch"
                app:layout_constraintEnd_toEndOf="@id/etSearch"
                app:layout_constraintTop_toTopOf="@id/etSearch" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnExport"
                style="@style/button"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:background="@drawable/button_stroke"
                android:text="Export"
                android:textColor="@color/brown"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etSearch" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/btnExport"
                app:tabIndicatorColor="#8B5A2B"
                app:tabIndicatorHeight="2dp"
                app:tabSelectedTextColor="#8B5A2B"
                app:tabTextColor="#B0B0B0">

                <com.google.android.material.tabs.TabItem
                    android:id="@+id/tabNew"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New" />

                <com.google.android.material.tabs.TabItem
                    android:id="@+id/tabApproved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Approved" />

                <com.google.android.material.tabs.TabItem
                    android:id="@+id/tabRejected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rejected" />
            </com.google.android.material.tabs.TabLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="600dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tabLayout" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pagingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/recyclerView">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imBackward"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16sp"
                    android:background="@drawable/btn2_background"
                    android:padding="6dp"
                    android:src="@drawable/backward_ic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recyclerView" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01 of 230"
                    app:layout_constraintBottom_toBottomOf="@id/imBackward"
                    app:layout_constraintEnd_toStartOf="@id/imForward"
                    app:layout_constraintStart_toEndOf="@id/imBackward"
                    app:layout_constraintTop_toTopOf="@id/imBackward" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imForward"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16sp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/btn1_background"
                    android:padding="6dp"
                    android:src="@drawable/forward_ic"
                    app:layout_constraintBottom_toBottomOf="@id/tvPages"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvPages" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>