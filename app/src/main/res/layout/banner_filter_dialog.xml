<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/_15sdp"
    android:background="@drawable/bottomsheet_bg"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tvToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFF9ED"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/bottomsheet_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="@string/filter"
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/black"
            android:layout_marginStart="@dimen/_15sdp"
            android:fontFamily="@font/poppins_medium"
            android:id="@+id/title"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/close_icon"
            android:id="@+id/closeIv"
            android:padding="@dimen/_15sdp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar"
        tools:layout_editor_absoluteX="25dp">


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvType"
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="@string/type"
            android:textSize="@dimen/_13sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tvType">

            <RadioButton
                android:id="@+id/rbBoth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@drawable/selector_radio_icon"
                android:checked="false"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:paddingVertical="@dimen/_6sdp"
                android:paddingStart="@dimen/_5sdp"
                android:text="@string/both"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                app:buttonTint="@null" />

            <RadioButton
                android:id="@+id/rbApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@drawable/selector_radio_icon"
                android:checked="false"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:paddingVertical="@dimen/_6sdp"
                android:paddingStart="@dimen/_5sdp"
                android:text="@string/app_banner"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                app:buttonTint="@null" />

            <RadioButton
                android:id="@+id/rbWeb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@drawable/selector_radio_icon"
                android:checked="false"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:paddingVertical="@dimen/_6sdp"
                android:paddingStart="@dimen/_5sdp"
                android:text="@string/web_banner"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                app:buttonTint="@null" />

        </RadioGroup>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCountry"
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="@string/choose_country"
            android:textSize="@dimen/_13sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rgType" />

        <TextView
            android:id="@+id/etCountry"
            style="@style/edit_text"
            android:layout_centerVertical="true"
            android:layout_marginTop="5dp"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_drop_down"
            android:drawablePadding="@dimen/_5sdp"
            android:editable="false"
            android:focusable="false"
            android:hint="@string/select_country"
            android:paddingVertical="@dimen/_9sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCountry" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCountry"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/btn_stroke_background"
            android:elevation="3dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/etCountry" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvChooseDate"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="@string/choose_date"
            android:textSize="@dimen/_13sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etCountry" />

        <TextView
            android:id="@+id/etFrom"
            style="@style/edit_text"
            android:layout_width="0dp"
            android:layout_centerVertical="true"
            android:layout_marginTop="5dp"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawablePadding="@dimen/_5sdp"
            android:editable="false"
            android:focusable="false"
            android:hint="@string/from_date_hint"
            android:paddingVertical="@dimen/_9sdp"
            app:layout_constraintEnd_toStartOf="@+id/etTo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvChooseDate" />

        <TextView
            android:id="@+id/etTo"
            style="@style/edit_text"
            android:layout_width="0dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_10sdp"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawablePadding="@dimen/_5sdp"
            android:editable="false"
            android:focusable="false"
            android:hint="@string/to_date_hint"
            android:paddingVertical="@dimen/_9sdp"
            app:layout_constraintBottom_toBottomOf="@+id/etFrom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/etFrom"
            app:layout_constraintTop_toTopOf="@+id/etFrom" />

        <TextView
            android:id="@+id/tvClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/button_stroke"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:paddingVertical="@dimen/_8sdp"
            android:text="@string/clear"
            android:textColor="@color/brown"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvApply"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etTo"
            android:layoutDirection="ltr"/>

        <TextView
            android:id="@+id/tvApply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_7sdp"
            android:background="@drawable/btn_background"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:paddingVertical="@dimen/_8sdp"
            android:text="@string/apply"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvClear"
            app:layout_constraintTop_toTopOf="@+id/tvClear"
            android:layoutDirection="ltr"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>