<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.orderManagement.OrderDetailFragment">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_35sdp"
        android:src="@drawable/back_ic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="Details"
        android:textSize="@dimen/_13sdp"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Confirmed"
        android:textSize="@dimen/_11sdp"
        android:textColor="#16B364"
        android:layout_marginEnd="@dimen/_15sdp"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/ivBack"
        app:layout_constraintBottom_toBottomOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clOrderInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_stroke15_background"
            android:backgroundTint="#F9F9F9"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:padding="@dimen/_10sdp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivBag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_order_bag"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvOrderId"
                app:layout_constraintBottom_toBottomOf="@+id/tvOrderIdValue"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Order ID"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@+id/ivBag"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOrderIdValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="#4556896"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintEnd_toStartOf="@+id/tvDateTime"
                app:layout_constraintStart_toStartOf="@+id/tvOrderId"
                app:layout_constraintTop_toBottomOf="@id/tvOrderId" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Date &amp; Time"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvOrderId"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDateTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="21/05/25 at 9:15 Pm"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"
                android:textAlignment="textEnd"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@+id/tvDate"
                app:layout_constraintTop_toBottomOf="@id/tvDate"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivOrderTypeBag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_order_bag"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvOrderType"
                app:layout_constraintBottom_toBottomOf="@+id/tvOrderTypeValue"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOrderType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="Order Type"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@+id/ivOrderTypeBag"
                app:layout_constraintTop_toBottomOf="@+id/tvOrderIdValue" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOrderTypeValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Normal Orders"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"
                android:textAlignment="textEnd"
                app:layout_constraintStart_toStartOf="@+id/tvOrderType"
                app:layout_constraintTop_toBottomOf="@id/tvOrderType" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clCustomerSellerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/card_stroke_background"
            android:layout_marginHorizontal="@dimen/_15sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Customer Name"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCustomerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Anwar Sheikh"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvCustomer"
                app:layout_constraintBottom_toBottomOf="@+id/tvCustomer"
                app:layout_constraintTop_toTopOf="@id/tvCustomer" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSeller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="Seller Name"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="@id/tvCustomer"
                app:layout_constraintTop_toBottomOf="@id/tvCustomer" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSellerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Atif Alsam"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@+id/tvSeller"
                app:layout_constraintEnd_toEndOf="@+id/tvCustomerName"
                app:layout_constraintBottom_toBottomOf="@+id/tvSeller"
                app:layout_constraintTop_toTopOf="@id/tvSeller" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDelivered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="Delivered by "
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="@id/tvCustomer"
                app:layout_constraintTop_toBottomOf="@id/tvSellerName" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDeliveredBy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Jhon"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@+id/tvDelivered"
                app:layout_constraintEnd_toEndOf="@+id/tvCustomerName"
                app:layout_constraintBottom_toBottomOf="@+id/tvDelivered"
                app:layout_constraintTop_toTopOf="@id/tvDelivered" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCountry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="Country"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="@id/tvCustomer"
                app:layout_constraintTop_toBottomOf="@id/tvDelivered" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCountryValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Kuwait"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@+id/tvCountry"
                app:layout_constraintEnd_toEndOf="@+id/tvCustomerName"
                app:layout_constraintBottom_toBottomOf="@+id/tvCountry"
                app:layout_constraintTop_toTopOf="@id/tvCountry" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvShippingLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="Shipping Location"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="@id/tvCustomer"
                app:layout_constraintTop_toBottomOf="@id/tvCountry" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvShippingLocationValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="KuFlat No.- 123, B Wing Khifayat Road, Oman, 112wait"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@+id/tvShippingLocation"
                app:layout_constraintEnd_toEndOf="@+id/tvCustomerName"
                app:layout_constraintTop_toTopOf="@id/tvShippingLocation" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:nestedScrollingEnabled="false"
            android:background="@drawable/card_stroke15_background"
            android:backgroundTint="#14ADADAD"
            android:layout_marginHorizontal="@dimen/_15sdp"
            tools:listitem="@layout/item_product"
            tools:itemCount="2"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:text="Delivery Instruction"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDeliveryInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="lorem ipsum dolor sit amet, consectetur adipisici elit,  sed do eiusmod tempor incididunt ut labore et dolore  magna aliqua. Ut enim ad"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCancelReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:text="Cancellation Reason"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCancellationReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="lorem ipsum dolor sit amet, consectetur adipisici elit,  sed do eiusmod tempor incididunt ut labore et dolore  magna aliqua. Ut enim ad"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clReturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:visibility="gone"
            android:id="@+id/tvReturn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:text="Return Details"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:visibility="gone"
            android:id="@+id/tvReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:text="Reason"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvReturn"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:visibility="gone"
            android:id="@+id/tvReturnReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="lorem ipsum dolor sit amet, consectetur adipisici elit,  sed do eiusmod tempor incididunt ut labore et dolore  magna aliqua. Ut enim ad"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvReason"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/llComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/_15sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="Product Ratings"
                android:layout_marginTop="@dimen/_15sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"/>

            <androidx.appcompat.widget.AppCompatRatingBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="5"
                android:rating="2"
                style="@style/Widget.AppCompat.RatingBar"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="Review"
                android:layout_marginTop="@dimen/_15sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="lorem ipsum dolor sit amet, consectetur adipisici elit,  sed do eiusmod tempor incididunt ut labore et dolore  magna aliqua. Ut enim ad"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="Seller Ratings"
                android:layout_marginTop="@dimen/_15sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"/>

            <androidx.appcompat.widget.AppCompatRatingBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="5"
                android:rating="2"
                style="@style/Widget.AppCompat.RatingBar"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="Review"
                android:layout_marginTop="@dimen/_15sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSellerReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="lorem ipsum dolor sit amet, consectetur adipisici elit,  sed do eiusmod tempor incididunt ut labore et dolore  magna aliqua. Ut enim ad"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"/>

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clOrderStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:padding="@dimen/_15sdp"
            android:background="#FFF7EA">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Order Status"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDeliveryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Delivery Date 21/02/25"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivConfirmed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_tick_order"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvOrderStatus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/viewConfirmed"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvConfirmed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Confirmed"
                android:layout_marginTop="@dimen/_5sdp"
                android:textColor="@color/brown"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivConfirmed" />

            <View
                android:id="@+id/viewConfirmed"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#6E4527"
                app:layout_constraintTop_toTopOf="@+id/ivConfirmed"
                app:layout_constraintBottom_toBottomOf="@+id/ivConfirmed"
                app:layout_constraintStart_toEndOf="@+id/ivConfirmed"
                app:layout_constraintEnd_toStartOf="@+id/ivPicked"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivPicked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_order_picked"
                app:layout_constraintTop_toTopOf="@+id/ivConfirmed"
                app:layout_constraintStart_toEndOf="@+id/viewConfirmed"
                app:layout_constraintEnd_toStartOf="@+id/viewPicked"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPicked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Picked"
                android:textColor="@color/brown"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="@+id/ivPicked"
                app:layout_constraintEnd_toEndOf="@+id/ivPicked"
                app:layout_constraintTop_toTopOf="@+id/tvConfirmed" />

            <View
                android:id="@+id/viewPicked"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#6E4527"
                app:layout_constraintTop_toTopOf="@+id/ivConfirmed"
                app:layout_constraintBottom_toBottomOf="@+id/ivConfirmed"
                app:layout_constraintStart_toEndOf="@+id/ivPicked"
                app:layout_constraintEnd_toStartOf="@+id/ivOnTheWay"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivOnTheWay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_order_on_way"
                app:layout_constraintTop_toTopOf="@+id/ivConfirmed"
                app:layout_constraintStart_toEndOf="@+id/viewPicked"
                app:layout_constraintEnd_toStartOf="@+id/viewOnTheWay"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOnTheWay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="On the Way"
                android:textColor="@color/brown"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="@+id/ivOnTheWay"
                app:layout_constraintEnd_toEndOf="@+id/ivOnTheWay"
                app:layout_constraintTop_toTopOf="@+id/tvConfirmed" />

            <View
                android:id="@+id/viewOnTheWay"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#6E4527"
                app:layout_constraintTop_toTopOf="@+id/ivConfirmed"
                app:layout_constraintBottom_toBottomOf="@+id/ivConfirmed"
                app:layout_constraintStart_toEndOf="@+id/ivOnTheWay"
                app:layout_constraintEnd_toStartOf="@+id/ivReturned"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivReturned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_order_picked"
                android:layout_marginEnd="@dimen/_15sdp"
                app:layout_constraintTop_toTopOf="@+id/ivConfirmed"
                app:layout_constraintStart_toEndOf="@+id/viewOnTheWay"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvReturned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Returned"
                android:textColor="@color/brown"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvConfirmed" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clBilling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:padding="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:background="@drawable/card_stroke_background"
            android:layout_marginHorizontal="@dimen/_15sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Total Amount"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="799 KD"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvTotal"
                app:layout_constraintBottom_toBottomOf="@+id/tvTotal"
                app:layout_constraintTop_toTopOf="@id/tvTotal" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCommission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="Commission Earned"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintStart_toStartOf="@id/tvTotal"
                app:layout_constraintTop_toBottomOf="@id/tvTotal" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/CommissionEarned"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="20 KD"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@+id/tvCommission"
                app:layout_constraintEnd_toEndOf="@+id/tvTotalAmount"
                app:layout_constraintBottom_toBottomOf="@+id/tvCommission"
                app:layout_constraintTop_toTopOf="@id/tvCommission" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnInvoice"
            app:layout_constraintTop_toBottomOf="@id/tvForgetPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/button"
            android:text="Download Invoice"
            android:background="@drawable/button_stroke"
            android:textColor="@color/brown"
            android:padding="@dimen/_8sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_marginBottom="@dimen/_20sdp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnAssignDriver"
            app:layout_constraintTop_toBottomOf="@id/tvForgetPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/button"
            android:text="Assign Driver"
            android:padding="@dimen/_8sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_marginBottom="@dimen/_20sdp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_20sdp"
            android:layout_marginHorizontal="@dimen/_15sdp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDriver"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_50sdp"
                android:src="@drawable/ic_placeholder"
                app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDriverName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="Salman Ahmad"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintEnd_toStartOf="@+id/ivEdit"
                app:layout_constraintStart_toEndOf="@+id/ivDriver"
                app:layout_constraintTop_toTopOf="@+id/ivDriver" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/edit_ic"
                android:paddingStart="@dimen/_10sdp"
                app:layout_constraintTop_toTopOf="@+id/ivDriver"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>