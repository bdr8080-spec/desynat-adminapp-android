<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.subscriptionPlan.AddPlanFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCountry"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/choose_country"
                android:textSize="@dimen/_13sdp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etCountry"
                style="@style/edit_text"
                android:paddingVertical="@dimen/_9sdp"
                android:drawablePadding="@dimen/_5sdp"
                android:hint="@string/select_country"
                android:editable="false"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginTop="5dp"
                android:textAlignment="viewStart"
                android:layout_centerVertical="true"
                android:drawableEnd="@drawable/ic_drop_down"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/plan_name"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/in_english"
                    android:layout_alignParentEnd="true"
                    android:textColor="#80000000"
                    android:textSize="@dimen/_10sdp"/>

            </RelativeLayout>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etEnglishPlanName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_plan_name"
                android:inputType="text"
                android:textAlignment="viewStart"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/plan_name"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/in_arabic"
                    android:layout_alignParentEnd="true"
                    android:textColor="#80000000"
                    android:textSize="@dimen/_10sdp"/>

            </RelativeLayout>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etArabicPlanName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_plan_name"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="text"
                android:textAlignment="viewStart"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="@string/duration"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etDuration"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    style="@style/edit_text"
                    android:hint="@string/enter_duration"
                    android:maxLength="2"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:inputType="number"
                    android:textAlignment="viewStart"
                    android:background="@drawable/edit_back" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etMonth"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    style="@style/edit_text"
                    android:hint="@string/select"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:inputType="text"
                    android:background="@drawable/edit_back"
                    android:editable="false"
                    android:clickable="true"
                    android:focusable="false"
                    android:textAlignment="viewStart"
                    android:drawablePadding="@dimen/_5sdp"
                    android:drawableEnd="@drawable/ic_drop_down"/>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvNewDuration"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="@string/new_duration"/>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llNewDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etNewDuration"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    style="@style/edit_text"
                    android:hint="@string/enter_new_duration"
                    android:maxLength="2"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:inputType="number"
                    android:background="@drawable/edit_back" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etNewMonth"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    style="@style/edit_text"
                    android:hint="@string/select"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:inputType="text"
                    android:background="@drawable/edit_back"
                    android:editable="false"
                    android:clickable="true"
                    android:focusable="false"
                    android:drawableEnd="@drawable/ic_drop_down"/>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="@string/product_type"/>

            <RadioGroup
                android:id="@+id/radioGroupProductType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbDefined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/defined"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/rbUnlimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unlimited"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNoOfProduct"
                    android:visibility="gone"
                    style="@style/edit_text_title"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:text="@string/no_of_products"/>

                <View
                    android:visibility="gone"
                    android:id="@+id/viewTvProduct"
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="wrap_content"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/no_of_videos"
                    android:textAlignment="viewStart"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatEditText
                    android:visibility="gone"
                    android:id="@+id/etNoOfProducts"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    style="@style/edit_text"
                    android:hint="@string/enter_number"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textAlignment="viewStart"
                    android:background="@drawable/edit_back" />

                <View
                    android:visibility="gone"
                    android:id="@+id/viewProduct"
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="wrap_content"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etNoOfVideo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    style="@style/edit_text"
                    android:hint="@string/enter_number"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textAlignment="viewStart"
                    android:background="@drawable/edit_back" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:text="@string/no_of_highlights"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:text="@string/no_of_employee"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etNoOfHighlight"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    style="@style/edit_text"
                    android:hint="@string/enter_number"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textAlignment="viewStart"
                    android:background="@drawable/edit_back" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etNoOfEmployee"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    style="@style/edit_text"
                    android:hint="@string/enter_number"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textAlignment="viewStart"
                    android:background="@drawable/edit_back" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="@string/stories"/>

            <RadioGroup
                android:id="@+id/radioGroupStories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_12sdp"
                android:button="@drawable/selector_radio_icon"
                android:paddingStart="@dimen/_8sdp"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/rbClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/close"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPrice"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/price"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etPrice"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_price"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="numberDecimal"
                android:textAlignment="viewStart"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvNewPrice"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/new_price"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:visibility="gone"
                android:id="@+id/etNewPrice"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_new_price"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="numberDecimal"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="@string/commission"/>

            <RadioGroup
                android:id="@+id/radioGroupCommision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbYes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/yes"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/rbNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvCommission"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Commission(%)"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:visibility="gone"
                android:id="@+id/etCommission"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_commission"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="number"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="@string/free_month"/>

            <RadioGroup
                android:id="@+id/radioGroupFreeMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbYesFreeMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/yes"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/rbNoFreeMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvNoOfFreeMonth"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/no_of_free_month"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:visibility="gone"
                android:id="@+id/etNoOfFreeMonth"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_number_of_free_months"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="number"
                android:maxLength="2"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnAdd"
                style="@style/button"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_30sdp"
                android:text="@string/add"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>